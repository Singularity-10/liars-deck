{
  // v92 P0 类型检查线：--noEmit 只检查不产出，分发形态不变（仍是 .js + <script> 全局）
  // 类型基座 = types/game.d.ts（ambient 全局，运行时零痕迹）；
  // 渐进点亮：未点亮文件头有 // @ts-nocheck 豁免，点亮一个 = 删头 + 修干净报错
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "types/**/*.d.ts"],
  "exclude": ["js/vendor/**", "dist/**"]
}
